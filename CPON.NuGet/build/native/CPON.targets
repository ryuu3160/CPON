<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- パッケージルートを組み立て -->
  <PropertyGroup>
    <_CPON_PackageRoot>$(MSBuildThisFileDirectory)..\..\</_CPON_PackageRoot>
    <_CPON_ContentRoot>$(_CPON_PackageRoot)contentFiles\cpp\any\any\</_CPON_ContentRoot>
    <_CPON_IncludeDir>$(_CPON_ContentRoot)include\</_CPON_IncludeDir>
    <_CPON_SrcDir>$(_CPON_ContentRoot)src\</_CPON_SrcDir>
  </PropertyGroup>

  <!-- 利用側プロジェクトに include path を追加 -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(_CPON_IncludeDir);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- 利用側プロジェクトに cpp をビルド対象として追加 -->
    <ClCompile Include="$(_CPON_SrcDir)**\*.cpp" />

    <!-- IDE上で見えるようにヘッダーも登録（任意だけど推奨） -->
    <ClInclude Include="$(_CPON_IncludeDir)**\*.h" />
    <ClInclude Include="$(_CPON_IncludeDir)**\*.hpp" />
  </ItemGroup>

</Project>