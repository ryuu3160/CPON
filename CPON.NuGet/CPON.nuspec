<?xml version="1.0"?>
<package>
  <metadata>
    <id>CPON</id>
    <version>1.1.0</version>
    <authors>ryuu3160</authors>
    <description>C++ Object Notation Parser. Requires C++ version 20 or higher.</description>
    <license type="expression">MIT</license>
